---
import type { Lang } from '../lib/i18n';
import { t } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const text = t(lang);
---
<footer>
  <p>© {new Date().getFullYear()} Lumen. {text.moreLanguages}</p>
  <div><a href="https://github.com/" aria-label="GitHub">GitHub</a><a href="https://linkedin.com/" aria-label="LinkedIn">LinkedIn</a></div>
</footer>
