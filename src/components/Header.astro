---
import { languages, languageNames, type Lang, t } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const text = t(lang);
const links = [
  ['', text.home], ['blog', text.blog], ['projects', text.projects], ['about', text.about], ['contact', text.contact],
];
---
<header class="site-header">
  <a class="brand" href={`/${lang}/`} aria-label="Melisa home">Melisa<span>.</span></a>
  <nav aria-label="Primary navigation">
    {links.map(([path, label]) => <a href={`/${lang}/${path}`}>{label}</a>)}
  </nav>
  <details class="language-picker">
    <summary aria-label="Choose language">{lang.toUpperCase()}</summary>
    <div class="language-menu">
      {languages.map((code) => <a href={`/${code}${Astro.url.pathname.slice(3)}`} lang={code}>{languageNames[code]}</a>)}
    </div>
  </details>
</header>
