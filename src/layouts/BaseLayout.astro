---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../lib/i18n';
import appearance from '../data/appearance.json';
const { lang, title = 'Melisa — Portfolio', description = 'Portfolio y perfil profesional de Melisa' } = Astro.props as { lang: Lang; title?: string; description?: string };
const fontStyles = ['elegant', 'modern', 'classic', 'minimal', 'soft', 'editorial', 'creative', 'professional', 'luxury'] as const;
const fontStyle = fontStyles.includes(appearance.fontStyle as typeof fontStyles[number]) ? appearance.fontStyle : 'elegant';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="9EB4cN_LZcxBfjpMWmbYfnRr-dJe_knXdjAzMKyjC8o" />
    <title>{title}</title>
  </head>
  <body class={`font-${fontStyle}`}>
    <Header lang={lang} />
    <main><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
<style is:global>
   @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Manrope:wght@400;500;600;700&family=Merriweather:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Poppins:wght@400;500;600;700&family=Quicksand:wght@400;500;600;700&family=Roboto:wght@400;500;700&family=Source+Sans+3:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');
   :root { --ink:#29213d; --paper:#fdfbff; --surface:#fff; --muted:#716b7f; --line:#e8e0f1; --accent:#b58a2d; --violet:#8269c7; --sun:#e6c875; --mint:#dfeeda; --pink:#f4e8ff; --lavender:#eee8fb; --font-body:'DM Sans',sans-serif; --font-heading:'Playfair Display',serif; --font-ui:'DM Mono',monospace; }
   body.font-modern { --font-body:'Poppins',sans-serif; --font-heading:'Poppins',sans-serif; --font-ui:'Poppins',sans-serif; } body.font-classic { --font-body:'Montserrat',sans-serif; --font-heading:'Cormorant Garamond',serif; --font-ui:'Montserrat',sans-serif; } body.font-minimal { --font-body:'Inter',sans-serif; --font-heading:'Libre Baskerville',serif; --font-ui:'Inter',sans-serif; } body.font-soft { --font-body:'Quicksand',sans-serif; --font-heading:'Playfair Display',serif; --font-ui:'Quicksand',sans-serif; } body.font-editorial { --font-body:'Manrope',sans-serif; --font-heading:'DM Serif Display',serif; --font-ui:'Manrope',sans-serif; } body.font-creative { --font-body:'Space Grotesk',sans-serif; --font-heading:'Space Grotesk',sans-serif; --font-ui:'Space Grotesk',sans-serif; } body.font-professional { --font-body:'Roboto',sans-serif; --font-heading:'Merriweather',serif; --font-ui:'Roboto',sans-serif; } body.font-luxury { --font-body:'Source Sans 3',sans-serif; --font-heading:'Cinzel',serif; --font-ui:'Source Sans 3',sans-serif; }
   * { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; background:radial-gradient(circle at 7% 10%,#fff0be 0,transparent 20%),radial-gradient(circle at 94% 26%,#e5dafb 0,transparent 23%),var(--paper); color:var(--ink); font-family:var(--font-body); font-size:15px; line-height:1.65; }
   a { color:inherit; text-decoration:none; transition:color .2s ease,transform .2s ease,background .2s ease; } a:hover { color:var(--accent); } main { max-width:1160px; margin:auto; padding:0 30px; min-height:70vh; }
   .site-header { max-width:1160px; margin:auto; padding:23px 30px; display:flex; align-items:center; gap:32px; border-bottom:1px solid color-mix(in srgb,var(--line),transparent 20%); }
   .brand { font-family:var(--font-heading); font-size:29px; font-weight:700; margin-right:auto; letter-spacing:-.075em; }.brand span { color:var(--accent); text-shadow:3px 3px 0 var(--sun); } nav { display:flex; gap:8px; } nav a { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; padding:7px 9px; border-radius:8px; } nav a:hover { color:var(--violet); background:var(--lavender); }
   .language-picker { position:relative; font-size:11px; font-weight:700; }.language-picker summary { cursor:pointer; list-style:none; border:1px solid var(--line); border-radius:9px; padding:6px 9px; background:var(--surface); }.language-menu { position:absolute; right:0; top:34px; z-index:2; background:var(--surface); box-shadow:0 12px 28px #382e5420; border:1px solid var(--line); border-radius:10px; min-width:120px; padding:7px; }.language-menu a { display:block; padding:5px; border-radius:5px; }.language-menu a:hover { background:var(--lavender); }
   h1,h2,h3 { font-family:var(--font-heading); font-weight:600; line-height:1.04; letter-spacing:-.055em; } h1 { font-size:clamp(48px,8vw,100px); margin:0; } h2 { font-size:clamp(32px,5vw,55px); } h3 { font-size:29px; margin:8px 0; } .eyebrow { color:var(--violet); text-transform:uppercase; letter-spacing:.14em; font-size:10px; font-family:var(--font-ui); font-weight:500; }.button-link { display:inline-block; border:1px solid var(--ink); border-radius:999px; padding:8px 13px; margin-top:14px; font-size:10px; font-family:var(--font-ui); text-transform:uppercase; letter-spacing:.07em; }.button-link:hover { background:var(--ink); color:#fff; transform:translateY(-2px); }
   .grid { display:grid; grid-template-columns:repeat(2,1fr); gap:17px; }.card { padding:27px; border:1px solid var(--line); border-radius:17px; background:var(--surface); box-shadow:0 8px 22px #493a5710; }.card:nth-child(4n+2) { background:#fff7dd; }.card:nth-child(4n+3) { background:#f4efff; }.card:nth-child(4n+4) { background:#ebfbf4; }.card:hover { transform:translateY(-4px); box-shadow:0 15px 28px #493a5720; }.card p { color:var(--muted); max-width:45ch; }.card-meta { color:var(--violet); font-family:var(--font-ui); font-size:10px; text-transform:uppercase; letter-spacing:.08em; }.tags { display:flex; flex-wrap:wrap; gap:6px; margin-top:14px; }.tag { padding:3px 8px; border-radius:99px; background:var(--lavender); color:#52427d; font-size:10px; }
   .page-head { padding:100px 0 54px; max-width:780px; }.page-head p { font-size:17px; color:var(--muted); max-width:52ch; }.prose { max-width:700px; margin:70px auto; font-family:var(--font-body); font-size:19px; line-height:1.8; }.prose h2,.prose h3 { margin-top:2em; }.prose a { color:var(--accent); text-decoration:underline; }
   footer { max-width:1160px; margin:80px auto 0; padding:27px 30px; border-top:1px solid var(--line); display:flex; justify-content:space-between; color:var(--muted); font-family:var(--font-ui); font-size:10px; } footer div { display:flex; gap:15px; }
   @media(max-width:700px) { .site-header { flex-wrap:wrap; gap:13px; } nav { order:3; width:100%; overflow:auto; gap:4px; } main { padding:0 20px; }.grid { grid-template-columns:1fr; }.site-header { padding:18px 20px; } footer { margin-top:50px; padding:20px; } }
</style>
