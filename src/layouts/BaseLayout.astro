---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../lib/i18n';
const { lang, title = 'Lumen', description = 'Personal blog and portfolio' } = Astro.props as { lang: Lang; title?: string; description?: string };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <Header lang={lang} />
    <main><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap');
  :root { --ink:#1e201e; --paper:#f8f6f1; --muted:#77766f; --line:#dedbd4; --accent:#dc5f39; }
  * { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; background:var(--paper); color:var(--ink); font-family:'DM Mono', monospace; font-size:14px; line-height:1.65; }
  a { color:inherit; text-decoration:none; } a:hover { color:var(--accent); } main { max-width:1160px; margin:auto; padding:0 30px; min-height:70vh; }
  .site-header { max-width:1160px; margin:auto; padding:27px 30px; display:flex; align-items:center; gap:32px; border-bottom:1px solid var(--line); }
  .brand { font-family:'Playfair Display',serif; font-size:25px; margin-right:auto; letter-spacing:-.06em; }.brand span { color:var(--accent); } nav { display:flex; gap:20px; } nav a { font-size:12px; text-transform:uppercase; letter-spacing:.06em; }
  .language-picker { position:relative; font-size:12px; }.language-picker summary { cursor:pointer; list-style:none; border:1px solid var(--line); padding:4px 8px; }.language-menu { position:absolute; right:0; top:30px; z-index:2; background:var(--paper); border:1px solid var(--line); min-width:110px; padding:8px; }.language-menu a { display:block; padding:4px; }
  h1,h2,h3 { font-family:'Playfair Display',serif; font-weight:500; line-height:1.08; letter-spacing:-.045em; } h1 { font-size:clamp(46px,8vw,100px); margin:0; } h2 { font-size:clamp(32px,5vw,55px); } h3 { font-size:28px; margin:8px 0; } .eyebrow { color:var(--accent); text-transform:uppercase; letter-spacing:.12em; font-size:11px; }.button-link { display:inline-block; border-bottom:1px solid var(--ink); padding-bottom:3px; margin-top:14px; font-size:12px; text-transform:uppercase; letter-spacing:.07em; }
  .grid { display:grid; grid-template-columns:repeat(2,1fr); gap:22px; }.card { padding:26px 0; border-top:1px solid var(--line); }.card p { color:var(--muted); max-width:45ch; }.card-meta { color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:.08em; }.tags { display:flex; flex-wrap:wrap; gap:6px; margin-top:14px; }.tag { padding:2px 7px; border:1px solid var(--line); font-size:10px; }
  .page-head { padding:100px 0 54px; max-width:780px; }.page-head p { font-size:16px; color:var(--muted); max-width:52ch; }.prose { max-width:700px; margin:70px auto; font-family:Georgia,serif; font-size:19px; line-height:1.8; }.prose h2,.prose h3 { margin-top:2em; }.prose a { color:var(--accent); text-decoration:underline; }
  footer { max-width:1160px; margin:80px auto 0; padding:25px 30px; border-top:1px solid var(--line); display:flex; justify-content:space-between; color:var(--muted); font-size:11px; } footer div { display:flex; gap:15px; }
  @media(max-width:700px) { .site-header { flex-wrap:wrap; gap:15px; } nav { order:3; width:100%; overflow:auto; gap:15px; } main { padding:0 20px; }.grid { grid-template-columns:1fr; }.site-header { padding:20px; } footer { margin-top:50px; padding:20px; } }
</style>
