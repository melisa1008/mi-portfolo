---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localeFromId, slugFromId, t, formatDate, type Lang } from '../../../lib/i18n';
export async function getStaticPaths() { const posts = await getCollection('blog', ({data}) => !data.draft); return posts.map(post => ({ params: { lang: localeFromId(post.id), slug: slugFromId(post.id) }, props: { post } })); }
const { post } = Astro.props;
const lang = Astro.params.lang as Lang;
const text = t(lang);
const { Content } = await render(post);
---
<BaseLayout lang={lang} title={`${post.data.title} — Lumen`} description={post.data.description}><article><header class="page-head"><p class="eyebrow">{text.writing} · {formatDate(post.data.date,lang)}</p><h1>{post.data.title}</h1><p>{post.data.description}</p></header><div class="prose"><Content /></div><a class="button-link" href={`/${lang}/blog/`}>← {text.back}</a></article></BaseLayout>
