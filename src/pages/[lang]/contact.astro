---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLang, languages, t } from '../../lib/i18n';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const { lang } = Astro.params; if (!isLang(lang)) return Astro.redirect('/es/'); const text = t(lang);
---
<BaseLayout lang={lang} title={`${text.contact} — Melisa`}><section class="contact"><p class="eyebrow">{text.contact}</p><h1>{text.contactTitle}</h1><p>{text.contactText}</p><a href="mailto:melisavmelo@gmail.com">melisavmelo@gmail.com ↗</a></section></BaseLayout>
<style>.contact{padding:17vh 0;max-width:900px}.contact>p:not(.eyebrow){max-width:480px;font-size:17px;color:var(--muted);margin:25px 0}.contact>a{font-family:'Playfair Display',serif;font-size:clamp(24px,4vw,48px);border-bottom:1px solid var(--ink)}</style>
