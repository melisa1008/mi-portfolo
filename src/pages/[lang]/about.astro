---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLang, languages, t } from '../../lib/i18n';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const { lang } = Astro.params; if (!isLang(lang)) return Astro.redirect('/es/'); const text = t(lang);
---
<BaseLayout lang={lang} title={`${text.about} — Melisa`}><section class="about"><p class="eyebrow">{text.about}</p><h1>{text.aboutTitle}</h1><div><p>{text.aboutText}</p><dl><div><dt>Formación</dt><dd>Estudiante en el EDT de Morges</dd></div><div><dt>Cualidades</dt><dd>Organizada · Centrada · Trabajadora</dd></div></dl></div></section></BaseLayout>
<style>.about{padding:14vh 0;display:grid;grid-template-columns:1.2fr 1fr;gap:50px}.about>div{font-size:17px;color:var(--muted)}dl{margin:32px 0 0;display:grid;gap:11px}dl div{padding:13px 0;border-top:1px solid var(--line)}dt{font:700 10px 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.08em;color:var(--violet)}dd{margin:3px 0 0;color:var(--ink);font-size:14px}@media(max-width:700px){.about{display:block}.about>div{margin-top:30px}}</style>
