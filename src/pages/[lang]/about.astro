---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLang, languages, t } from '../../lib/i18n';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const { lang } = Astro.params; if (!isLang(lang)) return Astro.redirect('/es/'); const text = t(lang);
---
<BaseLayout lang={lang} title={`${text.about} — Lumen`}><section class="about"><p class="eyebrow">{text.about}</p><h1>{text.aboutTitle}</h1><div><p>{text.aboutText}</p><p>Este texto es un ejemplo. Cámbialo desde <code>src/lib/i18n.ts</code> para cada idioma, junto con tu nombre, redes y correo.</p></div></section></BaseLayout>
<style>.about{padding:14vh 0;display:grid;grid-template-columns:1.2fr 1fr;gap:50px}.about div{font-size:17px;color:var(--muted)}code{font-size:12px;color:var(--accent)}@media(max-width:700px){.about{display:block}.about div{margin-top:30px}}</style>
