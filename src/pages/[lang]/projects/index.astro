---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLang, languages, localeFromId, slugFromId, t } from '../../../lib/i18n';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const { lang } = Astro.params;
if (!isLang(lang)) return Astro.redirect('/es/');
const text = t(lang);
const projects = (await getCollection('projects', ({id}) => localeFromId(id) === lang));
---
<BaseLayout lang={lang} title={`${text.projects} — Melisa`}><section class="page-head"><p class="eyebrow">{text.portfolio}</p><h1>{text.projects}</h1><p>{text.intro}</p></section><div class="grid">{projects.map(project => <article class="card"><div class="tags">{project.data.tags.map(tag => <span class="tag">{tag}</span>)}</div><h2><a href={`/${lang}/projects/${slugFromId(project.id)}/`}>{project.data.title}</a></h2><p>{project.data.description}</p><a class="button-link" href={`/${lang}/projects/${slugFromId(project.id)}/`}>{text.view} →</a></article>)}</div></BaseLayout>
