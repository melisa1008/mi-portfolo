---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLang, languages, localeFromId, slugFromId, t, formatDate } from '../../lib/i18n';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const { lang } = Astro.params;
if (!isLang(lang)) return Astro.redirect('/es/');
const text = t(lang);
const blog = (await getCollection('blog', ({ id, data }) => localeFromId(id) === lang && !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 2);
const projects = (await getCollection('projects', ({ id, data }) => localeFromId(id) === lang && data.featured)).slice(0, 2);
---
<BaseLayout lang={lang} title={`Lumen — ${text.home}`}>
  <section class="hero"><p class="eyebrow">Personal space · {text.portfolio}</p><h1>{text.hero}</h1><p>{text.intro}</p></section>
  <section class="section"><div class="section-heading"><p class="eyebrow">01 / {text.writing}</p><h2>{text.latest}</h2><a class="button-link" href={`/${lang}/blog/`}>{text.allArticles} →</a></div><div class="grid">{blog.map(post => <article class="card"><p class="card-meta">{formatDate(post.data.date, lang)}</p><h3><a href={`/${lang}/blog/${slugFromId(post.id)}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><a class="button-link" href={`/${lang}/blog/${slugFromId(post.id)}/`}>{text.read} →</a></article>)}</div></section>
  <section class="section"><div class="section-heading"><p class="eyebrow">02 / {text.portfolio}</p><h2>{text.work}</h2><a class="button-link" href={`/${lang}/projects/`}>{text.allProjects} →</a></div><div class="grid">{projects.map(project => <article class="card"><p class="card-meta">{project.data.tags.join(' · ')}</p><h3><a href={`/${lang}/projects/${slugFromId(project.id)}/`}>{project.data.title}</a></h3><p>{project.data.description}</p><a class="button-link" href={`/${lang}/projects/${slugFromId(project.id)}/`}>{text.view} →</a></article>)}</div></section>
</BaseLayout>
<style>.hero{padding:16vh 0 14vh;max-width:900px}.hero>p:last-child{max-width:510px;font-size:16px;color:var(--muted);margin:30px 0 0}.section{padding:65px 0;border-top:1px solid var(--line)}.section-heading{margin-bottom:30px}.section-heading h2{margin:5px 0}</style>
