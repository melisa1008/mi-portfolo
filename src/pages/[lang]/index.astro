---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLang, languages, localeFromId, slugFromId, t, formatDate } from '../../lib/i18n';
import appearance from '../../data/appearance.json';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const { lang } = Astro.params;
if (!isLang(lang)) return Astro.redirect('/es/');
const text = t(lang);
const blog = (await getCollection('blog', ({ id, data }) => localeFromId(id) === lang && !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 2);
const projects = (await getCollection('projects', ({ id, data }) => localeFromId(id) === lang && data.featured)).slice(0, 2);
---
<BaseLayout lang={lang} title={`Melisa — ${text.home}`}>
  <section class="hero"><div class="hero-copy"><p class="eyebrow">Melisa · EDT de Morges</p><h1>{text.hero}</h1><p>{text.intro}</p><div class="hero-notes"><span>organizada</span><span>✦</span><span>centrada</span><span>trabajadora</span></div></div><div class="hero-art"><i class="sparkle sparkle-one">✦</i><i class="sparkle sparkle-two">✿</i><img src={appearance.profileImage || '/profile-placeholder.svg'} alt={appearance.profileImage ? 'Foto de perfil de Melisa' : 'Espacio para la foto de perfil de Melisa'} /><span class="photo-label">Portfolio · 2026</span></div></section>
  <section class="section"><div class="section-heading"><p class="eyebrow">01 / {text.writing}</p><h2>{text.latest}</h2><a class="button-link" href={`/${lang}/blog/`}>{text.allArticles} →</a></div><div class="grid">{blog.map(post => <article class="card"><p class="card-meta">{formatDate(post.data.date, lang)}</p><h3><a href={`/${lang}/blog/${slugFromId(post.id)}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><a class="button-link" href={`/${lang}/blog/${slugFromId(post.id)}/`}>{text.read} →</a></article>)}</div></section>
  <section class="section"><div class="section-heading"><p class="eyebrow">02 / {text.portfolio}</p><h2>{text.work}</h2><a class="button-link" href={`/${lang}/projects/`}>{text.allProjects} →</a></div><div class="grid">{projects.map(project => <article class="card"><p class="card-meta">{project.data.tags.join(' · ')}</p><h3><a href={`/${lang}/projects/${slugFromId(project.id)}/`}>{project.data.title}</a></h3><p>{project.data.description}</p><a class="button-link" href={`/${lang}/projects/${slugFromId(project.id)}/`}>{text.view} →</a></article>)}</div></section>
</BaseLayout>
<style>.hero{min-height:570px;padding:12vh 0 10vh;display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:30px}.hero-copy>p:last-of-type{max-width:510px;font-size:17px;color:var(--muted);margin:26px 0 0}.hero-notes{display:flex;align-items:center;flex-wrap:wrap;gap:9px;margin-top:28px;color:var(--violet);font:10px var(--font-ui);text-transform:uppercase;letter-spacing:.1em}.hero-notes span{padding:5px 8px;background:var(--surface);border:1px solid var(--line);border-radius:99px}.hero-notes span:nth-child(2){background:var(--sun);border-color:var(--sun);color:var(--ink)}.hero-art{height:400px;position:relative;border-radius:46% 54% 49% 51% / 45% 42% 58% 55%;background:linear-gradient(135deg,#f4edff,#fff3d5);padding:18px;transform:rotate(4deg)}.hero-art img{width:100%;height:100%;object-fit:cover;border-radius:43% 57% 46% 54% / 42% 47% 53% 58%;display:block;box-shadow:0 15px 30px #48386930}.sparkle{position:absolute;z-index:1;font-style:normal;display:grid;place-items:center}.sparkle-one{color:var(--violet);font-size:42px;left:-17px;top:42px}.sparkle-two{color:var(--accent);font-size:38px;right:-13px;bottom:65px}.photo-label{position:absolute;z-index:1;bottom:27px;left:-37px;padding:7px 11px;border-radius:99px;background:#fff;color:var(--violet);box-shadow:0 5px 15px #493a5720;font:10px var(--font-ui);text-transform:uppercase;letter-spacing:.07em;transform:rotate(-4deg)}.section{padding:65px 0;border-top:1px solid var(--line)}.section-heading{margin-bottom:30px}.section-heading h2{margin:5px 0}@media(max-width:700px){.hero{min-height:0;padding:80px 0 64px;display:block}.hero-art{height:300px;margin:48px 20px 0}.photo-label{left:-16px}.sparkle-one{left:-10px}}</style>
